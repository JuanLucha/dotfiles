[Unit]
Description=ChromaDB Vector Database Server (MT Semantic Memory)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dotfiles/mt-mcp
ExecStart=%h/dotfiles/mt-mcp/.venv/bin/chroma run \
    --host 0.0.0.0 \
    --port 8000 \
    --path %h/.gemini/memory_db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
